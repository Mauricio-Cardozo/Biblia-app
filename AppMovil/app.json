{
  "expo": {
    "name": "Iglesia Digital",
    "slug": "AppMovil",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "iglesia-digital",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.iglesiadigital.app",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#0D1B2A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0D1B2A",
          "dark": {
            "backgroundColor": "#0D1B2A"
          }
        }
      ],
      "expo-sqlite",
      "expo-font",
      [
        "expo-navigation-bar",
        {
          "hidden": true,
          "style": "light"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "995af4b4-7be4-479b-a839-2521656ac264"
      }
    },
    "owner": "mauricio-cardozo"
  }
}
